    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceRoot}",
            "executable": "build/mg100_aws/zephyr/zephyr.elf",
            "name": "Debug",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "nRF52840_xxAA",
            "interface": "swd"
        },
        {
            "name": "Gateway Config Wizard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/gateway_config_wizard.py",
            "cwd": "${workspaceFolder}/scripts",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}